# ─── Studio web ───────────────────────────────────────────────
KINGDOM_PORT=8080
KINGDOM_HOST=0.0.0.0
# Dossier des données (base SQLite, sons). Par défaut : ./var
# KINGDOM_DATA_DIR=/srv/kingdom
# Compte administrateur créé au premier démarrage (sinon : le premier inscrit).
# KINGDOM_ADMIN_USERNAME=roi
# KINGDOM_ADMIN_PASSWORD=change-moi-tout-de-suite
# 0 = inscriptions fermées (seul un administrateur crée les comptes).
KINGDOM_ALLOW_REGISTRATION=1
KINGDOM_MAX_SERVERS_PER_ACCOUNT=10
# 1 si le Studio est servi en HTTPS (derrière un proxy) : cookies « Secure ».
KINGDOM_SECURE_COOKIES=0
KINGDOM_AUDIO_MAX_MB=100
# Adresse publique du Studio, sans / final (retour de la connexion Discord, adresse MCP affichée).
# KINGDOM_PUBLIC_URL=https://studio.exemple.fr

# ─── Connexion avec Discord (« Se connecter avec Discord ») ───
# Developer Portal → ton application → OAuth2 : copie Client ID et Client Secret,
# et ajoute la redirection <KINGDOM_PUBLIC_URL>/api/auth/discord/callback
KINGDOM_DISCORD_CLIENT_ID=
KINGDOM_DISCORD_CLIENT_SECRET=

# ─── Suivi par RoyaumeOS (Observatoire › KingdomEngine) ───
# Jeton partagé avec RoyaumeOS, 32 caractères minimum. Vide = statistiques désactivées.
# Générer : node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
KINGDOM_STATS_TOKEN=
# Facultatif : écoute supplémentaire qui ne sert QUE /api/stats (ex. pour un conteneur Docker du même serveur).
# KINGDOM_STATS_LISTEN=172.17.0.1:8091

# ─── Bot principal (un seul pour tous les serveurs Discord) ───
# Discord Developer Portal → ton application → Bot → Reset Token. Ne jamais le partager.
KINGDOM_CORE_TOKEN=

# ─── Voice Workers (un bot par connexion vocale simultanée) ───
# Une application Discord par worker. Jusqu'à 20.
VOICE_WORKER_1_TOKEN=
VOICE_WORKER_1_APPLICATION_ID=
VOICE_WORKER_2_TOKEN=
VOICE_WORKER_2_APPLICATION_ID=
# Chemin de FFmpeg si besoin (ffmpeg-static est utilisé par défaut).
# FFMPEG_PATH=
