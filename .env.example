# Jeton du bot (Discord Developer Portal → Bot → Reset Token). Ne jamais le partager.
DISCORD_TOKEN=
# Identifiant du serveur de test : les commandes y apparaissent immédiatement.
DISCORD_GUILD_ID=
# Monde chargé et fichier d'état (facultatif).
KINGDOM_WORLD=content/le-royaume/world.json
KINGDOM_STATE=var/le-royaume.state.json
# Une interface non utilisée depuis ce délai n'est plus rafraîchie d'elle-même (minutes).
KINGDOM_IDLE_MINUTES=30
