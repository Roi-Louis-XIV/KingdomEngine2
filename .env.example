# Laisser vide pour le stockage historique, ou choisir un disque volumineux.
# Exemple Debian : KINGDOM_DATA_DIR=/mnt/hdd/kingdomengine-data
KINGDOM_DATA_DIR=
KINGDOM_DATABASE=var/kingdom.db
KINGDOM_CORE_TOKEN=
KINGDOM_APPLICATION_ID=
KINGDOM_GUILD_ID=
# Un token différent par profil géré dans le Studio, ex. EDGAR_BOT_TOKEN=
EDGAR_BOT_TOKEN=
EDGAR_APPLICATION_ID=
EDOUARD_BOT_TOKEN=
EDOUARD_APPLICATION_ID=
ROLAND_BOT_TOKEN=
ROLAND_APPLICATION_ID=
SYLVAIN_BOT_TOKEN=
SYLVAIN_APPLICATION_ID=
WAGNER_BOT_TOKEN=
WAGNER_APPLICATION_ID=
FFMPEG_PATH=ffmpeg
# 127.0.0.1 en local ; 0.0.0.0 pour rendre KingdomWeb accessible sur le réseau.
KINGDOM_WEB_HOST=127.0.0.1
KINGDOM_WEB_PORT=8000
KINGDOM_PUBLIC_URL=
KINGDOM_GIT_BRANCH=agent/kingdomengine2-v2
KINGDOM_BACKUP_DIR=/var/backups/kingdomengine
KINGDOM_ADMIN_TOKEN=change-me
KINGDOM_ADMIN_USERNAME=admin
KINGDOM_ADMIN_PASSWORD=change-me
# Compte autorisé à ouvrir l'administration interne Payen Studio (/platform-admin).
KINGDOM_PLATFORM_ADMIN_USERNAME=admin
# Limite logique des présences vocales simultanées ; vide = nombre de workers disponibles.
KINGDOM_MAX_CONCURRENT_VOICE_PRESENCES=
# Mettre 0 pour masquer et désactiver l'inscription publique.
KINGDOM_ALLOW_REGISTRATION=1
# Activer uniquement lorsque KingdomWeb est servi en HTTPS.
KINGDOM_SECURE_COOKIES=0
