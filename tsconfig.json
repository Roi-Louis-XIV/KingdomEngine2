{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "packages/engine/src",
    "packages/engine/test",
    "apps/server/src",
    "apps/server/test"
  ]
}
